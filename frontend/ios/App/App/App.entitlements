<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Task #90 — Sign in with Apple. Required for AuthenticationServices
	     to return a real identityToken at runtime. The matching capability
	     must also be enabled on the Apple Developer App ID
	     (dk.bonbox.app) under Identifiers → Capabilities → Sign In with
	     Apple. Without that pairing, the app builds but credential
	     requests fail with ASAuthorizationError 1000 (unknown). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
