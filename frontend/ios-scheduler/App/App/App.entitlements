<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Native push for the staff Scheduler app. Pairs with the Push
	     Notifications capability on the dk.bonbox.scheduler App ID in the
	     Apple Developer portal.

	     "development" is correct HERE: debug builds sign against a
	     development provisioning profile whose aps-environment is
	     development — hardcoding "production" makes every on-device
	     Run fail codesigning. Distribution (TestFlight / App Store)
	     re-signing rewrites this to "production" automatically; the
	     automation only works in that direction. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
