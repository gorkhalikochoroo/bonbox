<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>BonBox Scheduler</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The bundled @capacitor/camera plugin references the camera and photo
	     library frameworks (staff attach a photo to a Besked). Apple's static
	     check (error 90683) requires a purpose string for every referenced
	     sensitive-data API even if a given flow doesn't call it. Mirrors the
	     owner app's proven set; Face ID is intentionally absent — nothing in
	     this app references LocalAuthentication. -->
	<key>NSCameraUsageDescription</key>
	<string>BonBox Scheduler uses the camera so you can take a photo to send in a message to your workplace.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BonBox Scheduler needs access to your photos so you can attach one to a message.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BonBox Scheduler needs permission to save a photo to your library.</string>
	<!-- Location is used ONLY at the moment you clock in, to confirm you're at
	     the workplace when your manager has turned on the location check. It is
	     never tracked in the background and your coordinates are never stored.
	     Without this string iOS silently denies the WKWebView geolocation
	     request, so clock-in can never get a fix and every punch is flagged
	     "unverified" — this key is what lets the permission prompt appear. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BonBox Scheduler uses your location only when you clock in, to confirm you are at your workplace. It is never tracked in the background and your location is never stored.</string>
	<!-- BonBox uses only standard HTTPS/TLS (export-exempt); declaring this
	     skips the export-compliance prompt on every TestFlight upload,
	     matching the owner app (ios/App/App/Info.plist). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
